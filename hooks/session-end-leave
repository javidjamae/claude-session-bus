#!/usr/bin/env bash
# session-end-leave — Claude Code SessionEnd hook: deregister this session from the bus.
#
# Registered in ~/.claude/settings.json by install.sh. Fires once when a session
# ends and receives the hook payload as JSON on stdin:
#   {"session_id":"…","transcript_path":"…","cwd":"…","hook_event_name":"SessionEnd","reason":"…"}
#
# It matches on session_id — the same id `bus join` recorded from
# $CLAUDE_CODE_SESSION_ID — so it removes exactly this session's handle even when
# several sessions share a cwd. If the payload has no session_id it falls back to
# cwd, which `bus leave --by-cwd` refuses to act on when that cwd is ambiguous.
#
# Best-effort by nature: SessionEnd does NOT fire on SIGKILL, a closed terminal
# window, or a crash. `bus who`'s "stale?" flags remain the backstop for those.
#
# Fires for EVERY Claude Code session on the machine, so it must be a fast, quiet
# no-op for sessions that never joined the bus — and must never fail the shutdown.
set -uo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
BUS="$SELF_DIR/../bus"

payload="$(cat 2>/dev/null)"

# Pull one top-level string field out of the payload. The schema is flat with
# uuid/path values, so this stays dependency-free rather than requiring jq.
json_str() {
  printf '%s' "$payload" \
    | sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" \
    | head -1
}

sid="$(json_str session_id)"
cwd="$(json_str cwd)"

if [ -n "$sid" ]; then
  "$BUS" leave --by-session "$sid" >/dev/null 2>&1
elif [ -n "$cwd" ]; then
  "$BUS" leave --by-cwd "$cwd" >/dev/null 2>&1
fi

exit 0   # never block or fail session shutdown
