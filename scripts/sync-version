#!/usr/bin/env bash
# sync-version — copy package.json's version into BUS_VERSION in ./bus.
#
# Changesets bumps package.json; the bus itself is bash and reads nothing at
# runtime, so the version users see (`bus version`) is baked into the script.
# This runs as part of `npm run version` (the changesets version PR), and the
# test suite fails if the two ever drift.
set -e
DIR="$(cd "$(dirname "$0")/.." && pwd)"
v="$(sed -n 's/^  "version": *"\([^"]*\)".*/\1/p' "$DIR/package.json" | head -1)"
[ -n "$v" ] || { echo "sync-version: could not read version from package.json" >&2; exit 1; }
sed -i.bak "s/^BUS_VERSION=\"[^\"]*\"/BUS_VERSION=\"$v\"/" "$DIR/bus"
rm -f "$DIR/bus.bak"
grep -q "^BUS_VERSION=\"$v\"" "$DIR/bus" || { echo "sync-version: BUS_VERSION line not found in bus" >&2; exit 1; }
echo "BUS_VERSION -> $v"
