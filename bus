#!/usr/bin/env bash
# bus — a tiny local coordination channel for Claude Code sessions.
#
# One shared append-only log + @mention addressing. Each session's listener
# greps the log for its own @handle, so a session is only ever woken when it is
# tagged — untagged traffic costs zero. Any session can read the full log for
# context. See SKILL.md. No network, no daemon, no dependencies beyond coreutils.
set -uo pipefail

# Bumped on releases; `bus version` appends the git commit when run from a
# checkout, which is the precise answer — the skill install is a symlink, so
# whatever the checkout has IS what every session runs.
BUS_VERSION="0.3.0"

BUS_DIR="${SESSION_BUS_DIR:-$HOME/.claude/session-bus}"
LOG="$BUS_DIR/bus.log"
ROSTER="$BUS_DIR/roster"
CURSORS="$BUS_DIR/cursors"   # one file per handle: how far into bus.log it has read
BLOBS="$BUS_DIR/blobs"       # payloads too big or too multi-line to inline in the log
LISTENERS="$BUS_DIR/listeners"  # one lock per handle: who is tailing the log for it
mkdir -p "$BUS_DIR" "$CURSORS" "$BLOBS" "$LISTENERS"; : >>"$LOG"; : >>"$ROSTER"
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" 2>/dev/null && pwd)"

# Timestamp for log lines. Dated so messages are unambiguous across days.
# Format: 'MM-DD HH:MM' (e.g. 08-03 00:51). bus-filter matches on @handle and the
# leading '[<handle> ' self-echo guard — never on the timestamp — so this is safe.
now() { date '+%m-%d %H:%M'; }

# now() minus N hours, as 'MM-DD HH:MM' (BSD date, GNU date fallback). Used as a
# lexical cutoff — 'MM-DD HH:MM' sorts correctly within a calendar year.
now_minus_hours() {
  date -v-"$1"H '+%m-%d %H:%M' 2>/dev/null || date -d "-$1 hours" '+%m-%d %H:%M' 2>/dev/null
}

# --- read cursors -----------------------------------------------------------
# Each handle records a byte offset into the append-only log: everything before
# it has been shown to that handle, so `catchup` is simply "the rest of the file,
# filtered to my mentions" — exact and uncapped, where a time window would be a
# guess wrong in both directions (a long absence loses messages past the edge, a
# busy day gets truncated).
#
# The offset is advanced by whatever has actually SHOWN the mail: `catchup`,
# `bus wait`, and a graceful leave made while a streaming `bus listen` is still
# running (that listener delivers live without touching the cursor, so the
# leave is the moment to record that the log was read). A leave with no
# streaming listener leaves the cursor alone: `bus wait` keeps it exact on its
# own, and mail that landed between two waits has been shown to nobody. It is
# also deliberately NOT advanced when `prune` reaps a hard-killed session: we
# cannot know when that session stopped reading, so its successor re-sees some
# already-delivered messages. Every ambiguity here resolves toward showing a
# message twice rather than dropping it once.

log_size() { wc -c <"$LOG" 2>/dev/null | tr -d ' '; }

handle_slug() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9_-' '-'; }
cursor_file() { printf '%s/%s' "$CURSORS" "$(handle_slug "$1")"; }
cursor_get()  { _cf="$(cursor_file "$1")"; [ -f "$_cf" ] || return 1; cat "$_cf" 2>/dev/null; }
# Written whole or not at all (temp file + rename). A reader that caught a
# plain `>` between its truncate and its write would see an empty cursor, and
# an empty cursor reads as "no cursor": start from the end, mail skipped.
cursor_write() { # <file> <offset>
  printf '%s\n' "$2" >"$1.$$" 2>/dev/null && mv -f "$1.$$" "$1" 2>/dev/null
}
# Monotonic: a stale writer (an old session leaving late) must never rewind a
# cursor that a live session has already advanced past.
cursor_set() {
  _cf="$(cursor_file "$1")"; _cur="$(cat "$_cf" 2>/dev/null)"
  case "${_cur:-}" in ''|*[!0-9]*) _cur=0;; esac
  case "${2:-}" in ''|*[!0-9]*) return 0;; esac
  [ "$2" -gt "$_cur" ] && cursor_write "$_cf" "$2"
  return 0
}
# The one sanctioned rewind: a cursor past the end of the log points into a file
# that no longer exists (the log was truncated or replaced), so the offset means
# nothing. Left in place it would outrank every later cursor_set — and each
# catchup would replay the whole log again, forever.
cursor_rewind() { cursor_write "$(cursor_file "$1")" "$2"; }

# Raw log bytes [from, to). Both ends are byte offsets, so a reader that
# snapshots the size once sees exactly that much and nothing appended after it.
log_window() { # <from> <to>
  [ "$2" -gt "$1" ] || return 0   # BSD head rejects a zero count
  tail -c "+$(( $1 + 1 ))" "$LOG" 2>/dev/null | head -c "$(( $2 - $1 ))"
}

# The offset just past the last WHOLE line in [from, to). A cursor must only
# ever rest on a line boundary: a reader that catches a writer mid-append and
# steps over the half line would never be shown the message it belongs to.
whole_lines_end() { # <from> <to>
  _wl_n="$(log_window "$1" "$2" | wc -l | tr -d ' ')"
  case "${_wl_n:-}" in ''|0|*[!0-9]*) printf '%s' "$1"; return 0;; esac
  _wl_b="$(log_window "$1" "$2" | head -n "$_wl_n" | wc -c | tr -d ' ')"
  case "${_wl_b:-}" in ''|*[!0-9]*) _wl_b=0;; esac
  printf '%s' "$(( $1 + _wl_b ))"
}

# The offset just past the last whole line of the log as it stands: "the end",
# for anything that parks a cursor there (join's seed, a leave). Almost always
# simply the size; only a writer caught mid-append makes the two differ, and a
# log line is far shorter than the 64K this looks back over.
log_boundary() {
  _lb_size="$(log_size)"
  case "${_lb_size:-}" in ''|0|*[!0-9]*) printf '0'; return 0;; esac
  # $(...) strips a trailing newline, so empty means the last byte IS one.
  if [ -z "$(log_window "$(( _lb_size - 1 ))" "$_lb_size")" ]; then printf '%s' "$_lb_size"; return 0; fi
  _lb_from=$(( _lb_size > 65536 ? _lb_size - 65536 : 0 ))
  whole_lines_end "$_lb_from" "$_lb_size"
}

# The mentions of <handle> in log bytes [from, to), as bus-filter prints them.
# Returns the FILTER's status: "matched nothing" and "could not run" both print
# nothing, and a caller that cannot tell them apart would step the cursor over
# mail it never showed.
unseen_mentions() { # <handle> <from> <to>
  log_window "$2" "$3" | "$SELF_DIR/bus-filter" "$1"
  return "${PIPESTATUS[1]}"
}

# The one canonical form of a handle, or rc 1 with the reason on stderr.
# Handles live in log address fields, |-delimited roster rows, and lock/cursor
# FILENAMES — so a handle is folded to lowercase (every matcher is
# case-insensitive anyway) and anything that would not survive all three
# verbatim is refused. Two distinct raw handles that slug to one filename would
# otherwise share a listener lock and hard-refuse each other.
canon_handle() { # <raw>
  _ch="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
  case "$_ch" in
    ''|*[!a-z0-9_-]*)
      echo "error: invalid handle '$1' — use letters, digits, '-' and '_' only." >&2
      return 1;;
  esac
  printf '%s' "$_ch"
}

# --- blobs ------------------------------------------------------------------
# The log is line-oriented: one message, one line, address field first. A raw
# newline in a message body would write continuation lines carrying no address
# field at all — bus-filter drops them and the recipient silently receives a
# truncated message. So anything multi-line or oversized is stored whole in a
# blob and the log carries a one-line preview plus its key.

blob_put() {  # <file> -> prints the key
  _sum="$(cksum <"$1" 2>/dev/null | awk '{n=$1; print substr(n, length(n)-4)}')"
  _k="$(date '+%Y%m%d-%H%M%S')-${_sum:-00000}"
  cp "$1" "$BLOBS/$_k" 2>/dev/null || return 1
  printf '%s' "$_k"
}

# Drop blobs nobody is going to ask for again. Prints the count (never silent).
blob_sweep() {
  _days="${SESSION_BUS_BLOB_DAYS:-30}"
  [ -d "$BLOBS" ] || return 0
  _n=0
  # Read the list rather than word-splitting find's output: blob keys are
  # generated and contain no spaces today, but a path that ever did would be
  # split into pieces and quietly not deleted. The heredoc keeps the loop in
  # this shell, so the count survives it.
  while IFS= read -r _f; do
    [ -n "$_f" ] || continue
    rm -f "$_f" 2>/dev/null && _n=$((_n+1))
  done <<EOF
$(find "$BLOBS" -type f -mtime +"$_days" 2>/dev/null)
EOF
  [ "$_n" -gt 0 ] && printf '%s' "$_n"
  return 0
}

# Print the exact command that arms a handle's listener. `bus wait` blocks until
# the handle is next tagged, prints the message and exits — so it is armed as a
# background command (which has no time limit) and re-armed after each message.
# It sits behind the same duplicate-listener guard as `bus listen`, so a session
# that forgets it is already armed gets an immediate refusal instead of double
# delivery.
arm_cmd() {
  printf '%s/bus wait %s\n' "$SELF_DIR" "$1"
}
# How to run it, said the same way everywhere the arm command is handed out.
ARM_HOW="run it in the background (Bash tool, run_in_background); it exits when you are tagged — handle the message, then run it again"

# The streaming alternative: the tail|bus-filter pipeline (address-field
# matching, no self-echo), for a harness whose Monitor can stay armed.
listen_cmd() {
  printf '%s/bus listen %s\n' "$SELF_DIR" "$1"
}

roster_drop() { grep -v -iE "^$1\\|" "$ROSTER" >"$ROSTER.tmp" 2>/dev/null; mv "$ROSTER.tmp" "$ROSTER" 2>/dev/null; return 0; }

# Roster line format: handle|cwd|joined|session_id|pid|pstart
# Field 4 (Claude Code session id, from $CLAUDE_CODE_SESSION_ID at join time) is
# what the SessionEnd hook matches on, so auto-leave removes exactly the ending
# session's entry — several sessions can share a cwd. Fields 5/6 are the owning
# Claude Code process and its start time, used by `prune` (see below). Legacy
# 3/4-field lines simply have those fields empty; they are never auto-left or
# reaped, and are rewritten to the full width the first time `prune` runs.
handles_by_session() { awk -F'|' -v s="$1" '$4 != "" && $4 == s { print $1 }' "$ROSTER" 2>/dev/null; }
handles_by_cwd()     { awk -F'|' -v c="$1" '$2 == c { print $1 }' "$ROSTER" 2>/dev/null; }

# --- liveness ---------------------------------------------------------------
# The SessionEnd hook only covers *graceful* endings. A hard kill — SIGKILL, a
# closed terminal window, a crash — never fires it, and used to strand a roster
# row forever. So `join` also records the pid of the Claude Code process that
# owns the session; a row whose process is gone is provably dead and gets reaped.
# This is a check, not a timeout: an idle-but-listening session stays listed no
# matter how long it has been quiet, which a last-activity TTL would get wrong.

proc_start() { ps -o lstart= -p "$1" 2>/dev/null | sed 's/^ *//;s/ *$//'; }

# THE liveness proof, singular: <pid> is running AND — when a start time was
# recorded — is still the same process (pids get recycled, hence the start-time
# guard). Every judgement of a recorded pid (roster rows, listener locks)
# derives from this one predicate, so the roster and the locks can never
# disagree about the same process.
pid_alive() { # <pid> <recorded_start>
  case "${1:-}" in ''|*[!0-9]*) return 1;; esac
  _pa_c="$(proc_start "$1")"
  [ -n "$_pa_c" ] || return 1
  [ -z "${2:-}" ] || [ "$_pa_c" = "$2" ]
}

# Walk up from this script to the owning `claude` process. Empty if there isn't
# one (bus run straight from a shell), which simply means "not reapable".
claude_pid() {
  p="$$"; i=0
  while [ -n "$p" ] && [ "$p" != "0" ] && [ "$p" != "1" ] && [ "$i" -lt 12 ]; do
    c="$(ps -o comm= -p "$p" 2>/dev/null)"
    [ -n "$c" ] || return 0
    case "${c##*/}" in claude|claude-code) printf '%s' "$p"; return 0;; esac
    p="$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')"
    i=$((i+1))
  done
}

# Drop rows whose owning process is gone (or whose pid was recycled by a
# different process — hence the start-time guard). Prints the reaped handles.
# Rows with no pid are kept: absence of proof of death is not proof of death.
# Caller must hold the lock.
prune_dead() {
  _force="${1:-}"
  command -v ps >/dev/null 2>&1 || return 0
  [ -s "$ROSTER" ] || return 0
  # Every variable here is _p-prefixed on purpose: this runs inside `join`, and a
  # plainly-named `read -r ... sid ...` silently overwrote the joining session's
  # own $sid — which wrote an empty session id to the roster and quietly disabled
  # auto-leave for that handle.
  reaped=""; forced=""
  : >"$ROSTER.tmp"
  while IFS='|' read -r _ph _pcwd _pjoined _psid _ppid _pstart || [ -n "${_ph:-}" ]; do
    [ -n "${_ph:-}" ] || continue
    case "${_ppid:-}" in
      ''|*[!0-9]*)
        # No pid to judge: a row from a plain-shell join, where there was no
        # Claude Code process to walk up to. Kept by default because prune runs
        # unbidden inside `who` and `join`, and an unrelated command must not
        # silently deregister a session it cannot assess. `--force` is the
        # caller saying they know these are gone.
        [ -n "$_force" ] && { forced="$forced $_ph"; _ph=""; continue; }
        ;;
      *)
        if ! pid_alive "$_ppid" "${_pstart:-}"; then
          reaped="$reaped $_ph"
          _ph=""; continue
        fi
        ;;
    esac
    printf '%s|%s|%s|%s|%s|%s\n' "$_ph" "${_pcwd:-}" "${_pjoined:-}" "${_psid:-}" "${_ppid:-}" "${_pstart:-}" >>"$ROSTER.tmp"
    _ph=""
  done < "$ROSTER"
  mv "$ROSTER.tmp" "$ROSTER" 2>/dev/null
  # deliberately obscure loop variable: this runs inside `join`, whose own $h
  # must survive the call (a plain `for h` here silently re-registered a reaped
  # handle instead of the joining one).
  for _reap_h in $reaped; do
    printf '[%s %s] offline (reaped: session process gone)\n' "$_reap_h" "$(now)" >>"$LOG"
    printf '%s\n' "$_reap_h"
  done
  # Logged distinctly: these were dropped on the caller's say-so, not because the
  # process table proved anything. The log should never blur the two.
  for _reap_h in $forced; do
    printf '[%s %s] offline (reaped: no pid recorded, dropped by --force)\n' "$_reap_h" "$(now)" >>"$LOG"
    printf '%s\n' "$_reap_h"
  done
}

# Coarse mutex around roster read-modify-write. The SessionEnd hook makes
# concurrent mutations real (two sessions can end at the same instant), and
# rewriting the file unguarded would drop entries. mkdir is atomic everywhere;
# a lock held longer than ~3s is assumed stale and broken.
LOCKDIR="$BUS_DIR/.roster.lock"
unlock() { rmdir "$LOCKDIR" 2>/dev/null; return 0; }
lock() {
  i=0
  while ! mkdir "$LOCKDIR" 2>/dev/null; do
    i=$((i+1))
    if [ "$i" -ge 60 ]; then rmdir "$LOCKDIR" 2>/dev/null; mkdir "$LOCKDIR" 2>/dev/null; break; fi
    sleep 0.05
  done
  trap unlock EXIT
}

# Deregister one handle: drop from roster, note it in the log, and put down
# this session's listener for the handle (a leave that walks away from a live
# listener strands the handle for its next owner).
#
# The log is marked read here ONLY when a streaming `bus listen` is live for
# the handle: that listener delivered everything up to this instant without
# ever touching the cursor, so the gap starts here and nowhere else. With no
# streaming listener there is nothing to record — `bus wait` advances the
# cursor itself as it delivers — and advancing anyway would mark as seen the
# mail that landed since the last wait exited, which nobody has been shown.
# The check comes before the listener is released, while it can still be seen.
do_leave() { # <handle> [owner_sid] [force]
  roster_drop "$1"
  printf '[%s %s] offline\n' "$1" "$(now)" >>"$LOG"
  streaming_listener_live "$1" && cursor_set "$1" "$(log_boundary)"
  release_listener "$1" "${2:-${CLAUDE_CODE_SESSION_ID:-}}" "$(claude_pid)" "${3:-}"
}

# --- ownership --------------------------------------------------------------
# Registration is keyed on the session id; removal used to be keyed only on the
# handle, and the two disagree the moment a handle changes hands. A session that
# has been displaced (another session joined under its name) would otherwise
# deregister the LIVE holder on its way out — the row is gone while that
# session's listener keeps running, so it receives messages but is invisible in
# `who`. These read a row's identity fields so removal can check ownership.

row_field() { awk -F'|' -v hh="$1" -v n="$2" 'tolower($1)==tolower(hh) { print $n; exit }' "$ROSTER" 2>/dev/null; }

# Is this row's recorded process still the one that registered it?
row_alive() { pid_alive "$(row_field "$1" 5)" "$(row_field "$1" 6)"; }

# Is <handle> registered to a LIVE session other than <my_sid>? Prints that
# session's id. Reading a handle's mail advances its cursor, so it is only for
# the session that holds the handle: a displaced session that kept reading
# would eat the new holder's mail without ever showing it to them. Only judged
# when both sides identify themselves, as everywhere else — an unregistered
# handle or a call from a plain shell is nobody's to protect. Whether the
# registered session is still alive is not this function's question: `join` is
# where a name changes hands, and it already knows when a takeover is allowed.
foreign_holder() { # <handle> <my_sid>
  _fh_sid="$(row_field "$1" 4)"
  [ -n "${_fh_sid:-}" ] && [ -n "${2:-}" ] && [ "$_fh_sid" != "$2" ] || return 1
  printf '%s' "$_fh_sid"
}
refuse_foreign() { # <handle> <my_sid> <what> — exits 1 if the handle is someone else's
  _rf_owner="$(foreign_holder "$1" "$2")" || return 0
  echo "error: @$1 is registered to a different session ($_rf_owner), not this one — $3." >&2
  echo "       'bus whoami' shows the handle this session holds; 'bus join $1' takes this one if its session is gone." >&2
  exit 1
}

# --- listener locks ---------------------------------------------------------
# One live listener per session — enforced, not requested. A session that
# forgets it is already listening and arms a second Monitor used to get every
# message twice; now `bus listen` records who is tailing the log for each
# handle, and a duplicate simply refuses to start. Lock line format:
#   listener_pid|listener_pstart|claude_pid|claude_pstart|session_id|handle
# The pid+start pairs make both identities provable against the process table:
# a lock whose listener process is gone is stale and never blocks anyone.

listener_file() { printf '%s/%s' "$LISTENERS" "$(handle_slug "$1")"; }

# Is a streaming `bus listen` live for this handle right now? Told apart from a
# `bus wait` by its fifo — the lock line is the same for both, and stays that
# way so listeners armed by older code keep reading it.
streaming_listener_live() { # <handle>
  _sv_f="$(listener_file "$1")"
  [ -f "$_sv_f" ] || return 1
  IFS='|' read -r _sv_pid _sv_pstart _sv_rest <"$_sv_f" 2>/dev/null
  pid_alive "${_sv_pid:-}" "${_sv_pstart:-}" && [ -p "$LISTENERS/.fifo.$_sv_pid" ]
}

# Do these two identities belong to the same Claude session? Session-id
# evidence decides whenever both sides carry one — the id is what defines a
# session, and it survives a resume. The owning-process pid only breaks the
# tie when id evidence is missing (a plain-shell listener has neither). When
# NEITHER side has any evidence this cannot match, so the one-Monitor-per-
# session rule cannot protect a fully anonymous caller — `bus listen` warns
# about that at arm time; the per-handle rule still applies.
same_session() { # <their_sid> <their_cpid> <my_sid> <my_cpid>
  if [ -n "${1:-}" ] && [ -n "${3:-}" ]; then [ "$1" = "$3" ]; return; fi
  [ -n "${2:-}" ] && [ -n "${4:-}" ] && [ "$2" = "$4" ]
}

# Put a recorded listener down and clean up its lock + fifo. Waits for the
# process to actually die (or turn zombie — its traps have run by then) before
# removing the lock: a dying listener's own cleanup trap also removes its lock,
# and racing it while a successor writes a fresh lock to the same path would
# let the trap delete the successor's registration.
reap_listener_lock() { # <lockfile> <listener_pid>
  kill "$2" 2>/dev/null
  _rk_i=0
  while [ "$_rk_i" -lt 20 ]; do
    _rk_st="$(ps -o stat= -p "$2" 2>/dev/null | tr -d ' ')"
    case "${_rk_st:-}" in ''|Z*) break;; esac
    sleep 0.1; _rk_i=$((_rk_i+1))
  done
  kill -9 "$2" 2>/dev/null
  rm -f "$1" "$LISTENERS/.fifo.$2"
  return 0
}

# Which handle is this session's live listener armed under, if any? This is
# the guard's own question — per SESSION, not per handle — and the advisory
# layer (join/whoami) must ask the same one, or it would hand out an arm
# command the guard is guaranteed to refuse. Orphans (owning session's process
# provably gone) don't count: they deliver to nobody and the next `bus listen`
# or `bus prune` puts them down.
session_listener() { # <my_sid> <my_cpid> -> prints the handle; rc 1 if none
  for _sl_f in "$LISTENERS"/*; do
    [ -f "$_sl_f" ] || continue
    IFS='|' read -r _sl_pid _sl_pstart _sl_cpid _sl_cstart _sl_sid _sl_h <"$_sl_f" 2>/dev/null
    pid_alive "${_sl_pid:-}" "${_sl_pstart:-}" || continue
    case "${_sl_cpid:-}" in
      ''|*[!0-9]*) ;;   # no owner recorded: cannot judge orphan-ness, count it
      *) pid_alive "$_sl_cpid" "${_sl_cstart:-}" || continue;;
    esac
    if same_session "${_sl_sid:-}" "${_sl_cpid:-}" "${1:-}" "${2:-}"; then
      printf '%s\n' "${_sl_h:-${_sl_f##*/}}"
      return 0
    fi
  done
  return 1
}

# Clean the listener directory: drop locks whose listener process is gone, and
# put down orphans — listeners still tailing for a session whose process is
# provably dead. Run by `bus listen` before it judges blockers, and by the
# explicit `bus prune` (the documented SIGKILL backstop), so crashed sessions
# never leak pipelines or locks indefinitely. Prints what it did; caller must
# hold the lock.
listener_sweep() {
  for _ls_f in "$LISTENERS"/*; do
    [ -f "$_ls_f" ] || continue
    IFS='|' read -r _ls_pid _ls_pstart _ls_cpid _ls_cstart _ls_sid _ls_h <"$_ls_f" 2>/dev/null
    [ -n "${_ls_h:-}" ] || _ls_h="${_ls_f##*/}"
    if ! pid_alive "${_ls_pid:-}" "${_ls_pstart:-}"; then
      rm -f "$_ls_f"
      case "${_ls_pid:-}" in ''|*[!0-9]*) ;; *) rm -f "$LISTENERS/.fifo.$_ls_pid";; esac
      printf 'released @%s listener lock (listener process gone)\n' "$_ls_h"
      continue
    fi
    case "${_ls_cpid:-}" in
      ''|*[!0-9]*) ;;   # no owner recorded: cannot prove it an orphan, keep it
      *) if ! pid_alive "$_ls_cpid" "${_ls_cstart:-}"; then
           reap_listener_lock "$_ls_f" "$_ls_pid"
           printf 'put down @%s listener (pid %s, its session is gone)\n' "$_ls_h" "$_ls_pid"
         fi;;
    esac
  done
  return 0
}

# Release a handle's listener on the way out of the bus. A leave that walked
# away from a live listener used to leave the handle permanently unlistenable
# for its next owner ('armed by a different session — kill pid N') while the
# old session kept waking on mail for a name it no longer held. Only this
# session's own listener is stopped, unless <force> — the deliberate reclaim —
# says otherwise; stale locks are cleaned regardless.
release_listener() { # <handle> <my_sid> <my_cpid> [force]
  _re_f="$(listener_file "$1")"
  [ -f "$_re_f" ] || return 0
  # shellcheck disable=SC2034  # _re_h names the last field so read consumes it
  IFS='|' read -r _re_pid _re_pstart _re_cpid _re_cstart _re_sid _re_h <"$_re_f" 2>/dev/null
  if ! pid_alive "${_re_pid:-}" "${_re_pstart:-}"; then
    rm -f "$_re_f"
    case "${_re_pid:-}" in ''|*[!0-9]*) ;; *) rm -f "$LISTENERS/.fifo.$_re_pid";; esac
    return 0
  fi
  if [ -n "${4:-}" ] || same_session "${_re_sid:-}" "${_re_cpid:-}" "${2:-}" "${3:-}"; then
    reap_listener_lock "$_re_f" "$_re_pid"
    printf 'stopped the @%s listener (pid %s) — the task that armed it will report the command exited\n' "$1" "$_re_pid"
  fi
  return 0
}

# Claim <handle>'s listener slot for this process, or refuse and exit 1. Shared
# by `bus listen` and `bus wait`: both deliver a handle's mail to a session, so
# a session running either must not be able to start the other. The guard has
# to live HERE, at the moment the second listener would start — join can advise
# a forgetful session all it likes, but only the listener itself can make the
# duplicate fail instead of half-working (every message delivered twice,
# forever, silently).
listener_claim() { # <handle> <my_sid> <my_cpid> <my_cstart>
  _cl_lf="$(listener_file "$1")"
  [ -n "${2:-}${3:-}" ] || echo "warning: cannot attribute this listener to a session (no session id, no Claude process) — the one-listener-per-session rule cannot protect it." >&2
  lock
  # Clear the provably-dead first: stale locks (SIGKILLed listeners) and
  # orphans (listeners whose session's process is gone) — including orphans
  # under OTHER handles, or a crashed session's listener would leak until
  # someone happened to reuse its exact handle.
  _cl_swept="$(listener_sweep)"
  [ -n "$_cl_swept" ] && printf '%s\n' "$_cl_swept" | sed 's/^/note: /' >&2
  # Then judge the survivors — all provably live, owner alive or unknown.
  # Classify them ALL before refusing: the same-session verdict must win over
  # the foreign-holder one, or which refusal (and which remedy) the user sees
  # would depend on lock-filename collation order, and a session could be told
  # to kill a healthy peer's listener instead of hearing about its own.
  _cl_same=""; _cl_other=""; _cl_other_pid=""; _cl_foreign=""
  for _cl_f in "$LISTENERS"/*; do
    [ -f "$_cl_f" ] || continue
    IFS='|' read -r _cl_pid _cl_pstart _cl_cpid _cl_cstart _cl_sid _cl_h <"$_cl_f"
    [ -n "${_cl_h:-}" ] || _cl_h="${_cl_f##*/}"
    pid_alive "${_cl_pid:-}" "${_cl_pstart:-}" || continue
    if same_session "${_cl_sid:-}" "${_cl_cpid:-}" "${2:-}" "${3:-}"; then
      if [ "$_cl_f" = "$_cl_lf" ]; then _cl_same="$_cl_pid"; else _cl_other="$_cl_h"; _cl_other_pid="$_cl_pid"; fi
    elif [ "$_cl_f" = "$_cl_lf" ]; then
      _cl_foreign="$_cl_pid"
    fi
  done
  if [ -n "$_cl_same" ]; then
    unlock
    echo "error: this session is ALREADY listening as @$1 (pid $_cl_same)." >&2
    echo "       Do NOT arm a second listener — the existing one is still delivering." >&2
    exit 1
  fi
  if [ -n "$_cl_other" ]; then
    unlock
    echo "error: this session already has a live listener as @$_cl_other (pid $_cl_other_pid) — one listener per session." >&2
    echo "       Stop that one (TaskStop its task, and 'bus leave $_cl_other' if renaming) before listening as @$1." >&2
    exit 1
  fi
  if [ -n "$_cl_foreign" ]; then
    unlock
    echo "error: a live listener for @$1 is already armed by a different session (pid $_cl_foreign)." >&2
    echo "       Two listeners on one handle deliver every message twice. If that listener is truly dead, kill pid $_cl_foreign and retry." >&2
    exit 1
  fi
  printf '%s|%s|%s|%s|%s|%s\n' "$$" "$(proc_start "$$")" "${3:-}" "${4:-}" "${2:-}" "$1" >"$_cl_lf"
  unlock
}

# Take the lock down on the way out — but only if it is still OURS: a listener
# being put down by a successor must not delete the fresh lock that successor
# just wrote.
listener_unclaim() { # <handle>
  _uc_lf="$(listener_file "$1")"
  [ -f "$_uc_lf" ] || return 0
  IFS='|' read -r _uc_pid _uc_rest <"$_uc_lf" 2>/dev/null
  [ "${_uc_pid:-}" = "$$" ] && rm -f "$_uc_lf"
  return 0
}

# Time-windowed catchup: the fallback for handles with no cursor yet, and what
# you get when you ask for a window explicitly. Keep only lines tagging @h/@all
# (never self), then only lines newer than the cutoff. The timestamp is fields 2
# (MM-DD) and 3 (HH:MM]) of the '[' address token; a lexical compare of
# 'MM-DD HH:MM' is correct within a calendar year. Undated legacy lines are
# dropped when a window applies — their recency cannot be proven, and keeping
# them reproduces the old "re-dump everything" noise. They stay visible via
# 'bus log'. Self-heals once every session emits dated lines.
window_catchup() {
  awk -v h="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" -v cut="$(now_minus_hours "$2")" -F' :: ' '
    { a = tolower($1) }
    a ~ ("^\\[@?" h " ") { next }                            # drop self (senders log bare, but tolerate a leading @)
    { sub(/^\[[^]]*\][ \t]*/, "", a) }                       # drop the [sender ts] block: a sender token is not an address
    a !~ ("@(" h "|all)([^0-9a-z_]|$)") { next }             # must tag h/all
    {
      split($1, p, " ")                                      # p[2]=MM-DD p[3]=HH:MM]
      if (p[2] ~ /^[0-9][0-9]-[0-9][0-9]$/) {
        ts = p[2] " " substr(p[3], 1, 5)
        if (cut != "" && ts < cut) next                      # dated + older than window: drop
      } else if (cut != "") {
        next                                                 # undated (pre-dated-stamp): cannot prove recency, drop
      }
      print
    }
  ' "$LOG" 2>/dev/null
}

usage() {
  cat <<'EOF'
bus — local coordination for Claude Code sessions

  bus help                       this list
  bus join [handle]              register + print the command that arms your listener
                                 (no handle => a slug of the current directory;
                                 a handle a live session already holds is refused)
  bus whoami                     the handle THIS session is registered as
  bus who                        list registered handles (reaps dead ones first)
  bus send <from> @to [..] msg   post a message tagging recipient(s); @all = broadcast
                                 (multi-line/large payloads auto-store as a blob)
  bus catchup <handle> [hours]   mentions you have not been shown yet (exact, via a
                                 read cursor); pass N hours to override with a window
  bus log [N]                    tail the shared log for full context (default 80)
  bus put [file]                 store a payload (file or stdin); prints its blob key
  bus get <key>                  print a stored payload
  bus prune [--force]            drop handles whose process is gone; sweep old blobs
                                 (--force also drops rows that recorded no pid)
  bus wait <handle> [--timeout <seconds>]
                                 the listener to arm: block until you are next tagged,
                                 print what arrived, mark it seen, exit 0 — run it in the
                                 background and run it again after each message. Resumes
                                 from your read cursor, so nothing sent between two waits
                                 is missed. Exit 124 = --timeout passed with no mention.
                                 Refuses to start when this session already has a live
                                 listener.
  bus listen <handle>            the streaming listener, for a Monitor that can stay
                                 armed: prints every mention, never exits on its own
                                 (same one-listener-per-session refusal)
  bus listen-cmd <handle>        reprint the bus listen command
  bus leave [--force] <handle>   deregister (--force: also when the row belongs to
                                 another session — e.g. reclaiming a taken name)
  bus leave --by-session <id>    deregister whatever that Claude session joined as (used by the SessionEnd hook)
  bus leave --by-cwd [--force] <path>
                                 deregister by working directory (refuses if >1 handle shares it)
  bus version                    version + git commit of the code every session runs
EOF
}

cmd="${1:-}"; shift 2>/dev/null || true
case "$cmd" in
  join)
    h="${1:-}"
    if [ -n "$h" ]; then h="$(canon_handle "$h")" || exit 1; fi
    sid="${CLAUDE_CODE_SESSION_ID:-}"   # exported into every Bash tool call by Claude Code
    cpid="$(claude_pid)"                # owning Claude Code process, for the hard-kill reaper
    cstart=""; [ -n "$cpid" ] && cstart="$(proc_start "$cpid")"
    lock
    prune_dead >/dev/null               # joining is a good moment to reap dead rows
    # What does this session already hold? Keyed on the session id when there is
    # one (it is what defines a session, and it survives a resume), falling back
    # to the owning process for plain-shell joins.
    mine=""
    if [ -n "$sid" ]; then
      mine="$(handles_by_session "$sid")"
    elif [ -n "$cpid" ]; then
      mine="$(awk -F'|' -v p="$cpid" '$5 != "" && $5 == p { print $1 }' "$ROSTER" 2>/dev/null)"
    fi
    if [ -z "$h" ] && [ -n "$mine" ]; then
      # A bare join from a session that is already registered is a session that
      # FORGOT, not one that wants a second identity. Suffixing used to hand it
      # a fresh handle here — and, right behind it, a second Monitor. Answer
      # with the registration it already has instead.
      h="$(printf '%s\n' "$mine" | head -1)"
      unlock
      echo "already joined as '$h' — this session is registered, nothing to do."
      lh="$(session_listener "$sid" "$cpid")"
      if [ "$(handle_slug "${lh:-}")" = "$(handle_slug "$h")" ] && [ -n "$lh" ]; then
        echo "Your @$h listener is still running. Do NOT arm another listener."
      elif [ -n "$lh" ]; then
        echo "This session is still listening as @$lh — one listener per session."
        echo "Stop that one (TaskStop its task, and 'bus leave $lh' if renaming) before arming @$h."
      else
        echo "No live listener found for @$h. Arm your listener — $ARM_HOW:"
        arm_cmd "$h"
      fi
      exit 0
    fi
    if [ -z "$h" ]; then
      # No handle given: derive one from the project directory, and if a *live*
      # session already holds it, suffix instead of stealing it (two sessions in
      # one repo is the normal case). An explicitly-given handle is never
      # suffixed — reusing it deliberately re-registers, e.g. after a restart.
      base="$(printf '%s' "${PWD##*/}" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-//;s/-$//')"
      [ -n "$base" ] || base="session"
      h="$base"; n=1
      while grep -qiE "^$h\|" "$ROSTER" 2>/dev/null; do n=$((n+1)); h="$base$n"; done
    fi
    # One live session per handle. Two sessions sharing a name half-works and
    # fails confusingly: both listeners wake on every @mention (delivery ignores
    # the roster), they share one read cursor so either can eat the other's
    # catchup, and only the newcomer appears in `who`. So a taken name is simply
    # refused. Dead rows are already reaped above, so a restart under the same
    # name never trips this — and re-registering from the same session is not a
    # collision either.
    if grep -qiE "^$h\|" "$ROSTER" 2>/dev/null && row_alive "$h"; then
      owner_sid="$(row_field "$h" 4)"; owner_pid="$(row_field "$h" 5)"
      if [ "${owner_sid:-}" != "${sid:-}" ] && [ "${owner_pid:-}" != "${cpid:-}" ]; then
        unlock
        # Suggest the next free suffix, so the answer to "taken" is a name, not a puzzle.
        n=2; while grep -qiE "^$h$n\|" "$ROSTER" 2>/dev/null; do n=$((n+1)); done
        echo "error: the handle @$h is taken — a live session holds it (pid $owner_pid, $(row_field "$h" 2))." >&2
        echo "       Try @$h$n instead." >&2
        exit 1
      fi
    fi
    roster_drop "$h"
    printf '%s|%s|%s|%s|%s|%s\n' "$h" "$PWD" "$(date '+%Y-%m-%d %H:%M')" "$sid" "$cpid" "$cstart" >>"$ROSTER"
    printf '[%s %s] online (%s)\n' "$h" "$(now)" "$PWD" >>"$LOG"   # unmentioned: context only, wakes no one
    # Seed a read cursor for a handle that has never had one, so its first
    # `catchup` shows nothing rather than the entire history. A cursor that
    # already exists is left strictly alone — that IS the unread gap, and this
    # is the moment we would otherwise destroy it.
    cursor_get "$h" >/dev/null 2>&1 || cursor_set "$h" "$(log_boundary)"
    unlock
    # A re-join while this session's listener is still running (the classic
    # "did I already join?" moment) must not re-print the arm instruction —
    # that instruction is exactly what talks a forgetful session into arming
    # the second Monitor this feature exists to prevent. The question is the
    # guard's own, per SESSION: a listener live under any OTHER handle would
    # make `bus listen $h` refuse, so advising "arm it" would be a lie.
    lh="$(session_listener "$sid" "$cpid")"
    if [ "$(handle_slug "${lh:-}")" = "$(handle_slug "$h")" ] && [ -n "$lh" ]; then
      echo "joined as '$h'. Your @$h listener is STILL RUNNING — do NOT arm another listener."
    elif [ -n "$lh" ]; then
      echo "joined as '$h', but this session is still listening as @$lh — one listener per session."
      echo "Stop that one (TaskStop its task, and 'bus leave $lh' if renaming); then run 'bus join $h' again for the arm command."
    else
      echo "joined as '$h'. Arm your listener — $ARM_HOW:"
      arm_cmd "$h"
    fi
    [ -n "$sid" ] || echo "note: CLAUDE_CODE_SESSION_ID is unset, so auto-leave on session end can't fire for '$h' — run 'bus leave $h' yourself." >&2
    ;;
  listen)
    # The streaming listener: the tail|bus-filter pipeline, behind the
    # duplicate-listener guard. It never exits on its own, so it suits a harness
    # whose Monitor can stay armed; where Monitors are time-capped, `bus wait`
    # is the listener to arm instead.
    h="$(canon_handle "${1:?usage: bus listen <handle>}")" || exit 1
    lf="$(listener_file "$h")"
    sid="${CLAUDE_CODE_SESSION_ID:-}"
    cpid="$(claude_pid)"; cstart=""; [ -n "$cpid" ] && cstart="$(proc_start "$cpid")"
    listener_claim "$h" "$sid" "$cpid" "$cstart"
    # Both stages started separately across a FIFO so each has a pid the trap
    # can kill. A plain `tail | filter` pipeline hides tail's pid, and a tail
    # that outlives its consumer lingers until its next write dies on SIGPIPE.
    fifo="$LISTENERS/.fifo.$$"
    rm -f "$fifo"
    mkfifo "$fifo" || { rm -f "$lf"; echo "error: could not create listener fifo" >&2; exit 1; }
    listen_cleanup() {
      listener_unclaim "$h"
      rm -f "$fifo"
      [ -n "${tail_pid:-}" ] && kill "$tail_pid" 2>/dev/null
      [ -n "${filter_pid:-}" ] && kill "$filter_pid" 2>/dev/null
      return 0
    }
    trap listen_cleanup EXIT
    trap 'exit' INT TERM HUP
    # tail's stderr stays on the Monitor's stream on purpose: `tail -F` retries
    # a vanished or unreadable log forever, so muting it would leave a listener
    # that delivers nothing while everything reports it RUNNING.
    tail -F -n 0 "$LOG" >"$fifo" & tail_pid=$!
    "$SELF_DIR/bus-filter" "$h" <"$fifo" & filter_pid=$!
    wait "$filter_pid"
    ;;
  wait)
    # The listener a session arms: block until this handle is next tagged, print
    # what arrived, mark it seen, exit 0. A session runs it as a background
    # command — which, unlike a Monitor, has no time limit — and is re-invoked
    # the moment it exits; it handles the message and arms the next wait.
    #
    # Delivery is exact across that gap because nothing here reads from "now":
    # every wait starts at the handle's read cursor, the same one `catchup`
    # advances, so a message that lands between two waits is simply the first
    # thing the next one finds.
    #
    # A plain poll on the log's size, deliberately. There is no pipeline to
    # manage, so there is nothing to orphan: `tail -F | filter` leaves both
    # stages running when its parent is SIGKILLed, and a listener that is
    # re-armed after every message would leak a pair each time that happened.
    timeout=""; timeout_set=""; h=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --timeout)   [ $# -ge 2 ] || { echo "error: --timeout needs a number of seconds" >&2; exit 1; }
                     timeout="$2"; timeout_set=1; shift 2;;
        --timeout=*) timeout="${1#--timeout=}"; timeout_set=1; shift;;
        -*)          echo "error: unknown option '$1' — usage: bus wait <handle> [--timeout <seconds>]" >&2; exit 1;;
        *)           [ -z "$h" ] || { echo "error: one handle only — usage: bus wait <handle> [--timeout <seconds>]" >&2; exit 1; }
                     h="$1"; shift;;
      esac
    done
    [ -n "$h" ] || { echo "usage: bus wait <handle> [--timeout <seconds>]" >&2; exit 1; }
    h="$(canon_handle "$h")" || exit 1
    deadline=""
    if [ -n "$timeout_set" ]; then
      case "$timeout" in
        ''|*[!0-9]*) echo "error: --timeout takes whole seconds, got '$timeout'" >&2; exit 1;;
      esac
      deadline=$(( SECONDS + 10#$timeout ))   # 10#: a leading zero is not octal
    fi
    # Seconds between looks at the log. Anything `sleep` would reject, or zero,
    # falls back to the default: a sleep that returns at once turns this loop
    # into a busy spin.
    poll="${SESSION_BUS_WAIT_POLL:-2}"
    case "$poll" in ''|*[!0-9.]*|*.*.*) poll=2;; esac
    case "$poll" in *[1-9]*) ;; *) poll=2;; esac
    sid="${CLAUDE_CODE_SESSION_ID:-}"
    cpid="$(claude_pid)"; cstart=""; [ -n "$cpid" ] && cstart="$(proc_start "$cpid")"
    refuse_foreign "$h" "$sid" "its mail is not this session's to take"
    listener_claim "$h" "$sid" "$cpid" "$cstart"
    sleep_pid=""
    wait_cleanup() {
      listener_unclaim "$h"
      [ -n "${sleep_pid:-}" ] && kill "$sleep_pid" 2>/dev/null
      return 0
    }
    trap wait_cleanup EXIT
    # Say so on the way out: a wait that just vanishes with 143 looks like a
    # glitch worth retrying, when it is usually somebody's decision — and a
    # session that re-arms by reflex may no longer hold the handle.
    trap 'echo "bus wait: stopped before any mention of @$h arrived (bus leave, a TaskStop, or the session ending). Nothing was marked seen. Check bus whoami before arming again." >&2; exit 143' INT TERM HUP
    cf="$(cursor_file "$h")"
    if [ ! -f "$cf" ]; then
      # Never joined, so there is no last-seen position to resume from. Start
      # at the end rather than replaying history, exactly as join seeds it.
      off="$(log_boundary)"; cursor_set "$h" "$off"
      echo "note: @$h has no read cursor yet — waiting for mentions from now on." >&2
    else
      off="$(cursor_get "$h" 2>/dev/null)" || off=""
      case "${off:-}" in
        ''|*[!0-9]*)
          # A cursor that exists but cannot be read is not "no cursor": guessing
          # the end would skip mail, guessing the start would replay the log.
          echo "bus wait: @$h's read cursor ($cf) is unreadable — run 'bus catchup $h' to reset it, then arm again." >&2
          exit 1;;
      esac
    fi
    ticks=0; misses=0
    while :; do
      # A catchup run since the last look has already shown everything up to
      # its cursor; pick that up rather than delivering the same lines again.
      if IFS= read -r seen 2>/dev/null <"$cf"; then
        case "${seen:-}" in ''|*[!0-9]*) ;; *) [ "$seen" -gt "$off" ] && off="$seen";; esac
      fi
      if size="$(wc -c 2>/dev/null <"$LOG")"; then
        size=$(( size )); misses=0
        # Shorter than the cursor: the log was truncated or replaced and the
        # offset means nothing. Replay the lot rather than lose it (catchup's
        # rule), and rewind the cursor so that happens exactly once.
        if [ "$size" -lt "$off" ]; then off=0; cursor_rewind "$h" 0; fi
        if [ "$size" -gt "$off" ]; then
          end="$(whole_lines_end "$off" "$size")"
          if [ "$end" -gt "$off" ]; then
            if ! out="$(unseen_mentions "$h" "$off" "$end")"; then
              echo "bus wait: could not filter the log ($SELF_DIR/bus-filter failed) — nothing was marked seen." >&2
              exit 1
            fi
            if [ -n "$out" ]; then
              # About to mark mail as seen — so be sure somebody is there to
              # see it. A wait that outlived its session would otherwise eat
              # the message: printed to nobody, and then hidden from the
              # catchup of whoever takes the handle next.
              if [ -n "$cpid" ] && ! pid_alive "$cpid" "$cstart"; then
                echo "bus wait: the session that armed this (pid $cpid) is gone — leaving @$h's mail unread." >&2
                exit 1
              fi
              # Print, THEN advance: if this dies in between, the message is
              # shown twice rather than dropped once.
              printf '%s\n' "$out" || exit 1
              cursor_set "$h" "$end"
              exit 0
            fi
            # Whole lines, none of them ours: step over them so they are not
            # re-scanned on every look.
            cursor_set "$h" "$end"; off="$end"
          fi
        fi
      else
        # One failed look is a blip (the log being replaced under us); a run of
        # them is a listener that delivers nothing while everything reports it
        # RUNNING. Say so and stop, so the session finds out.
        misses=$(( misses + 1 ))
        if [ "$misses" -ge 5 ]; then
          echo "bus wait: cannot read $LOG — exiting rather than listen to nothing." >&2
          exit 1
        fi
      fi
      if [ -n "$deadline" ] && [ "$SECONDS" -ge "$deadline" ]; then
        echo "bus wait: no mention of @$h in ${timeout}s." >&2
        exit 124
      fi
      # Do not outlive the session: nobody is left to re-arm, and nothing else
      # would stop this loop.
      ticks=$(( ticks + 1 ))
      if [ -n "$cpid" ] && [ $(( ticks % 15 )) -eq 0 ] && ! pid_alive "$cpid" "$cstart"; then
        echo "bus wait: the session that armed this (pid $cpid) is gone — exiting." >&2
        exit 1
      fi
      # Backgrounded so a TERM (e.g. `bus leave` putting this listener down) is
      # acted on at once instead of after the sleep; its output is discarded so
      # a straggler can never hold the caller's pipe open.
      sleep "$poll" >/dev/null 2>&1 & sleep_pid=$!
      wait "$sleep_pid" 2>/dev/null
      sleep_pid=""
    done
    ;;
  listen-cmd)
    listen_cmd "${1:?usage: bus listen-cmd <handle>}"
    ;;
  send)
    from="${1:?usage: bus send <from> @to [@to2...] message}"; shift
    from="${from#@}"   # whoami prints '@handle'; log lines carry the bare form, so normalize
    tos=""
    while [ $# -gt 0 ]; do case "$1" in @*) tos="$tos $1"; shift;; *) break;; esac; done
    [ -n "$tos" ] || { echo "error: no @recipient (e.g. bus send alice @bob \"hi\")" >&2; exit 1; }
    msg="$*"
    [ -n "$msg" ] || { echo "error: empty message" >&2; exit 1; }
    # A message that spans lines cannot go in the log as-is: only its first line
    # would carry the address field, and bus-filter would drop the rest — a
    # silent truncation with no error anywhere. Offload those (and anything
    # oversized) to a blob, and leave a one-line preview + key in the log.
    inline_max="${SESSION_BUS_INLINE_MAX:-800}"
    bytes="$(printf '%s' "$msg" | wc -c | tr -d ' ')"
    lines="$(printf '%s\n' "$msg" | wc -l | tr -d ' ')"
    if [ "$lines" -gt 1 ] || [ "$bytes" -gt "$inline_max" ]; then
      tmp="$BLOBS/.tmp.$$"; printf '%s\n' "$msg" >"$tmp"
      key="$(blob_put "$tmp")"; rm -f "$tmp"
      [ -n "$key" ] || { echo "error: could not write blob" >&2; exit 1; }
      # Preview: first line only, tabs/CRs flattened, clipped — the log stays
      # one-line-per-message and greppable no matter what was sent.
      preview="$(printf '%s\n' "$msg" | head -1 | tr '\t\r' '  ' | cut -c1-160)"
      msg="$preview … [blob $key: $lines lines, $bytes bytes — read it with: bus get $key]"
    fi
    printf '[%s %s]%s :: %s\n' "$from" "$(now)" "$tos" "$msg" >>"$LOG"   # ' :: ' delimits address field from body
    if [ -n "${key:-}" ]; then echo "sent to$tos (payload stored as blob $key)"; else echo "sent to$tos"; fi
    ;;
  put)
    # Store a payload without routing it anywhere; prints the key to reference in
    # a later `send`. Takes a path, or stdin — so a large file never has to be
    # squeezed through argv.
    src="${1:-}"
    if [ -n "$src" ]; then
      [ -f "$src" ] || { echo "error: no such file: $src" >&2; exit 1; }
      key="$(blob_put "$src")"
    else
      tmp="$BLOBS/.tmp.$$"; cat >"$tmp"
      [ -s "$tmp" ] || { rm -f "$tmp"; echo "error: empty payload on stdin" >&2; exit 1; }
      key="$(blob_put "$tmp")"; rm -f "$tmp"
    fi
    [ -n "$key" ] || { echo "error: could not write blob" >&2; exit 1; }
    printf '%s\n' "$key"
    ;;
  get)
    key="${1:?usage: bus get <blob-key>}"
    case "$key" in */*|..*) echo "error: bad blob key: $key" >&2; exit 1;; esac  # keys are flat names, never paths
    [ -f "$BLOBS/$key" ] || { echo "error: no such blob: $key" >&2; exit 1; }
    cat "$BLOBS/$key"
    ;;
  whoami)
    # "What am I on the bus?" — answered from the session's own identity rather
    # than from the working directory, since several sessions can share a repo.
    # Falls back to the owning process, then to the cwd, and says which it used
    # so a guess never reads like a fact.
    sid="${CLAUDE_CODE_SESSION_ID:-}"; cpid="$(claude_pid)"; hs=""; via=""
    [ -n "$sid" ] && { hs="$(handles_by_session "$sid")"; [ -n "$hs" ] && via="session id"; }
    if [ -z "$hs" ] && [ -n "$cpid" ]; then
      hs="$(awk -F'|' -v p="$cpid" '$5 != "" && $5 == p { print $1 }' "$ROSTER" 2>/dev/null)"
      [ -n "$hs" ] && via="owning process (pid $cpid)"
    fi
    if [ -z "$hs" ]; then
      hs="$(handles_by_cwd "$PWD")"
      [ -n "$hs" ] && via="working directory — a guess, since sessions can share a repo"
    fi
    if [ -z "$hs" ]; then
      echo "not on the bus. Join with: bus join <handle>" >&2
      exit 1
    fi
    # Answer "am I listening?" too — it is the question right behind "what am
    # I?", and guessing it wrong is how second Monitors get armed. Asked per
    # SESSION (the guard's own question), so a listener live under a different
    # handle is reported rather than an arm command the guard would refuse.
    lh="$(session_listener "$sid" "$cpid")"
    for h in $hs; do
      printf '@%s\n' "$h"
      printf '  matched by %s\n' "$via"
      if [ "$(handle_slug "${lh:-}")" = "$(handle_slug "$h")" ] && [ -n "$lh" ]; then
        printf '  listener:  RUNNING — do NOT arm another listener\n'
      elif [ -n "$lh" ]; then
        printf '  listener:  none for @%s — this session is listening as @%s (one listener per session)\n' "$h" "$lh"
      else
        printf '  listener:  NOT RUNNING — %s:\n' "$ARM_HOW"
        printf '             %s\n' "$(arm_cmd "$h")"   # $() strips arm_cmd's own newline
      fi
    done
    ;;
  who)
    lock; reaped="$(prune_dead)"; unlock
    for h in $reaped; do echo "  (reaped @$h — its Claude Code process is gone)"; done
    if [ ! -s "$ROSTER" ]; then echo "(nobody registered)"; exit 0; fi
    # Two tiers of liveness. Rows that recorded a pid have just been checked
    # against the process table by prune_dead, so surviving ones are genuinely
    # live — quiet is not stale. Rows without a pid (joined outside Claude Code,
    # or before this feature) fall back to the old guess: infer from the handle's
    # LAST activity in the log, flagging anything past the stale window.
    stale_hours=6
    stale_cut="$(now_minus_hours "$stale_hours")"
    # shellcheck disable=SC2034  # pstart names the last field so read consumes it; who doesn't use it
    while IFS='|' read -r hh pwd joined sid pid pstart; do
      [ -n "$hh" ] || continue
      case "${pid:-}" in
        ''|*[!0-9]*) ;;
        *) printf "  @%-10s %s (joined %s, process live — pid %s)\n" "$hh" "$pwd" "$joined" "$pid"; continue;;
      esac
      last="$(grep -iE "^\[@?$hh " "$LOG" 2>/dev/null | tail -1)"
      seen=""; flag=""
      if [ -n "$last" ]; then
        # extract 'MM-DD HH:MM' from '[handle MM-DD HH:MM] ...'
        seen="$(printf '%s' "$last" | sed -n 's/^\[[^ ]* \([0-9][0-9]-[0-9][0-9] [0-9][0-9]:[0-9][0-9]\)\].*/\1/p')"
      fi
      if [ -n "$seen" ]; then
        if [ -n "$stale_cut" ] && [ "$seen" \< "$stale_cut" ]; then flag=" — stale?"; fi
        printf "  @%-10s %s (joined %s, last seen %s%s)\n" "$hh" "$pwd" "$joined" "$seen" "$flag"
      elif [ -n "$last" ]; then
        # has log activity but only in the pre-dated-stamp format => hasn't spoken
        # since the upgrade. Can't time it, but that itself is a staleness signal.
        printf "  @%-10s %s (joined %s, last seen before dated-stamp upgrade — stale?)\n" "$hh" "$pwd" "$joined"
      else
        printf "  @%-10s %s (joined %s, no activity logged — stale?)\n" "$hh" "$pwd" "$joined"
      fi
    done < "$ROSTER"
    printf "  ('process live' is checked against the process table; 'last seen' rows predate that check and are only a guess)\n"
    ;;
  prune)
    # --force also drops rows carrying no pid. Only ever from an explicit prune —
    # the implicit ones inside `who`/`join` never pass it.
    force=""; [ "${1:-}" = "--force" ] && force=1
    lock; reaped="$(prune_dead "$force")"; lswept="$(listener_sweep)"; unlock
    swept="$(blob_sweep)"       # only the explicit prune sweeps blobs; who/join stay cheap
    if [ -z "$reaped" ] && [ -z "$swept" ] && [ -z "$lswept" ]; then echo "nothing to prune."; fi
    for h in $reaped; do echo "reaped: @$h"; done
    [ -n "$lswept" ] && printf '%s\n' "$lswept"
    [ -n "$swept" ] && echo "swept: $swept blob(s) older than ${SESSION_BUS_BLOB_DAYS:-30}d"
    ;;
  catchup)
    h="${1:?usage: bus catchup <handle> [hours]}"
    hours="${2:-}"
    refuse_foreign "$h" "${CLAUDE_CODE_SESSION_ID:-}" "catchup would mark its mail as seen ('bus log' reads without marking)"
    # Cursor BEFORE size. A `bus wait` may be advancing the cursor right now;
    # read the other way round, a cursor that moved past our older size
    # snapshot would look like a truncated log and trigger a full replay.
    off="$(cursor_get "$h" 2>/dev/null)" || off=""
    case "${off:-}" in ''|*[!0-9]*) off="";; esac
    size="$(log_boundary)"
    mark="$size"   # how far this catchup has shown; the cursor mode narrows it
    if [ -n "$hours" ]; then
      out="$(window_catchup "$h" "$hours")"          # explicit window: an override, not the default
    else
      if [ -z "$off" ]; then
        # No cursor at all: a handle from before cursors existed, or one that
        # never joined. Fall back to the old window rather than dumping history.
        out="$(window_catchup "$h" 12)"
      else
        # A cursor past the end of the file means the log was truncated out
        # from under us and the offset means nothing — replay the lot rather
        # than lose it.
        [ "$off" -gt "$size" ] && { off=0; cursor_rewind "$h" 0; }
        # Exactly the bytes up to the size snapshot, whole lines only — the
        # same window `bus wait` reads. Reading on to end-of-file instead would
        # show a line appended after the snapshot and then leave the cursor
        # short of it, and the next wait would deliver it a second time.
        mark="$(whole_lines_end "$off" "$size")"
        if ! out="$(unseen_mentions "$h" "$off" "$mark")"; then
          echo "error: could not filter the log ($SELF_DIR/bus-filter failed) — nothing was marked seen." >&2
          exit 1
        fi
      fi
    fi
    # Deliberately uncapped. The old 40-line clip silently ate the overflow on a
    # busy day, which is precisely the failure a cursor exists to remove.
    if [ -n "$out" ]; then printf '%s\n' "$out"; else echo "(nothing new)"; fi
    cursor_set "$h" "$mark"
    ;;
  log)
    tail -n "${1:-80}" "$LOG"
    ;;
  leave)
    lf=""; [ "${1:-}" = "--force" ] && { lf=1; shift; }   # accept --force before the target too
    case "${1:-}" in
      # Used by the SessionEnd hook: deregister whoever this session registered as.
      # Silent no-op (rc 0) when the session never joined — the hook fires for every
      # Claude Code session on the machine, bus user or not.
      --by-session)
        sid="${2:?usage: bus leave --by-session <session-id>}"
        lock
        hs="$(handles_by_session "$sid")"
        [ -n "$hs" ] || { echo "no bus registration for session $sid"; exit 0; }
        for h in $hs; do do_leave "$h" "$sid"; echo "left: @$h"; done
        ;;
      # Fallback for when no session id is available. Ambiguous by design when
      # several handles share a cwd, so it refuses rather than guessing.
      --by-cwd)
        force="$lf"; [ "${2:-}" = "--force" ] && { force=1; shift; }
        p="${2:?usage: bus leave --by-cwd [--force] <path>}"
        lock
        hs="$(handles_by_cwd "$p")"
        n="$(printf '%s' "$hs" | grep -c '[^[:space:]]')"
        [ "$n" -gt 0 ] || { echo "no bus registration for $p"; exit 0; }
        if [ "$n" -gt 1 ] && [ -z "$force" ]; then
          echo "error: $n handles registered at $p ($(echo $hs | tr '\n' ' ')) — pass a handle explicitly, or --force to drop all" >&2
          exit 1
        fi
        # Without a session id this is a guess from the working directory, and a
        # handle that changed hands makes it the wrong guess. Never remove a row
        # whose process is still running — unless that process is US, which is
        # the normal case: at SessionEnd the ending session is still alive and
        # is the one running this hook.
        me="$(claude_pid)"
        for h in $hs; do
          if [ -z "$force" ] && row_alive "$h" && [ "$(row_field "$h" 5)" != "${me:-}" ]; then
            echo "kept @$h: registered to a live process (pid $(row_field "$h" 5)) that is not this session"
            continue
          fi
          do_leave "$h" "" "$force"; echo "left: @$h"
        done
        ;;
      *)
        h="${1:?usage: bus leave [--force] <handle> | --by-session <id> | --by-cwd [--force] <path>}"
        [ "${2:-}" = "--force" ] && lf=1
        lock
        # A displaced session must not deregister whoever holds the name now.
        # Only enforced when both sides identify themselves: a row with no
        # session id, or a call from a plain shell, stays freely removable so
        # hand cleanup still works.
        row_sid="$(row_field "$h" 4)"; my_sid="${CLAUDE_CODE_SESSION_ID:-}"
        if [ -z "$lf" ] && [ -n "${row_sid:-}" ] && [ -n "$my_sid" ] && [ "$row_sid" != "$my_sid" ]; then
          unlock
          echo "error: @$h is registered to a different session ($row_sid), not this one." >&2
          echo "       It is probably still listening. Pass --force to deregister it anyway." >&2
          exit 1
        fi
        do_leave "$h" "" "$lf"
        echo "left."
        ;;
    esac
    ;;
  version)
    sha="$(git -C "$SELF_DIR" rev-parse --short HEAD 2>/dev/null)"
    printf 'bus %s%s\n' "$BUS_VERSION" "${sha:+ (git $sha)}"
    ;;
  help|-h|--help|'?')
    usage
    ;;
  *)
    [ -n "$cmd" ] && echo "bus: unknown command '$cmd'" >&2
    usage >&2
    exit 1
    ;;
esac
exit 0
