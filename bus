#!/usr/bin/env bash
# bus — a tiny local coordination channel for Claude Code sessions.
#
# One shared append-only log + @mention addressing. Each session's listener
# greps the log for its own @handle, so a session is only ever woken when it is
# tagged — untagged traffic costs zero. Any session can read the full log for
# context. See SKILL.md. No network, no daemon, no dependencies beyond coreutils.
set -uo pipefail

BUS_DIR="${SESSION_BUS_DIR:-$HOME/.claude/session-bus}"
LOG="$BUS_DIR/bus.log"
ROSTER="$BUS_DIR/roster"
mkdir -p "$BUS_DIR"; : >>"$LOG"; : >>"$ROSTER"
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" 2>/dev/null && pwd)"

# Timestamp for log lines. Dated so messages are unambiguous across days.
# Format: 'MM-DD HH:MM' (e.g. 08-03 00:51). bus-filter matches on @handle and the
# leading '[<handle> ' self-echo guard — never on the timestamp — so this is safe.
now() { date '+%m-%d %H:%M'; }

# now() minus N hours, as 'MM-DD HH:MM' (BSD date, GNU date fallback). Used as a
# lexical cutoff — 'MM-DD HH:MM' sorts correctly within a calendar year.
now_minus_hours() {
  date -v-"$1"H '+%m-%d %H:%M' 2>/dev/null || date -d "-$1 hours" '+%m-%d %H:%M' 2>/dev/null
}

# Print the exact Monitor listen command for a handle. Two guards prevent false wakes:
#  1. Match @<handle>/@all only in the ADDRESS field (before the ' :: ' delimiter),
#     so an @mention inside a message body never triggers a wake.
#  2. Drop the session's OWN messages ('[<handle> …'), so you never wake on self-echo.
listen_cmd() {
  printf "tail -F -n 0 %s | %s/bus-filter %s\n" "$LOG" "$SELF_DIR" "$1"
}

roster_drop() { grep -v -iE "^$1\\|" "$ROSTER" >"$ROSTER.tmp" 2>/dev/null; mv "$ROSTER.tmp" "$ROSTER" 2>/dev/null; return 0; }

# Roster line format: handle|cwd|joined|session_id
# Field 4 (Claude Code session id, from $CLAUDE_CODE_SESSION_ID at join time) is
# what the SessionEnd hook matches on, so auto-leave removes exactly the ending
# session's entry — several sessions can share a cwd. Legacy 3-field lines simply
# have an empty field 4 and are never auto-left.
handles_by_session() { awk -F'|' -v s="$1" '$4 != "" && $4 == s { print $1 }' "$ROSTER" 2>/dev/null; }
handles_by_cwd()     { awk -F'|' -v c="$1" '$2 == c { print $1 }' "$ROSTER" 2>/dev/null; }

# Coarse mutex around roster read-modify-write. The SessionEnd hook makes
# concurrent mutations real (two sessions can end at the same instant), and
# rewriting the file unguarded would drop entries. mkdir is atomic everywhere;
# a lock held longer than ~3s is assumed stale and broken.
LOCKDIR="$BUS_DIR/.roster.lock"
unlock() { rmdir "$LOCKDIR" 2>/dev/null; return 0; }
lock() {
  i=0
  while ! mkdir "$LOCKDIR" 2>/dev/null; do
    i=$((i+1))
    if [ "$i" -ge 60 ]; then rmdir "$LOCKDIR" 2>/dev/null; mkdir "$LOCKDIR" 2>/dev/null; break; fi
    sleep 0.05
  done
  trap unlock EXIT
}

# Deregister one handle: drop from roster, note it in the log.
do_leave() { roster_drop "$1"; printf '[%s %s] offline\n' "$1" "$(now)" >>"$LOG"; }

cmd="${1:-}"; shift 2>/dev/null || true
case "$cmd" in
  join)
    h="${1:?usage: bus join <handle>}"
    sid="${CLAUDE_CODE_SESSION_ID:-}"   # exported into every Bash tool call by Claude Code
    lock
    roster_drop "$h"
    printf '%s|%s|%s|%s\n' "$h" "$PWD" "$(date '+%Y-%m-%d %H:%M')" "$sid" >>"$ROSTER"
    printf '[%s %s] online (%s)\n' "$h" "$(now)" "$PWD" >>"$LOG"   # unmentioned: context only, wakes no one
    unlock
    echo "joined as '$h'. Arm your listener with this Monitor command (persistent):"
    listen_cmd "$h"
    [ -n "$sid" ] || echo "note: CLAUDE_CODE_SESSION_ID is unset, so auto-leave on session end can't fire for '$h' — run 'bus leave $h' yourself." >&2
    ;;
  listen-cmd)
    listen_cmd "${1:?usage: bus listen-cmd <handle>}"
    ;;
  send)
    from="${1:?usage: bus send <from> @to [@to2...] message}"; shift
    tos=""
    while [ $# -gt 0 ]; do case "$1" in @*) tos="$tos $1"; shift;; *) break;; esac; done
    [ -n "$tos" ] || { echo "error: no @recipient (e.g. bus send alice @bob \"hi\")" >&2; exit 1; }
    msg="$*"
    [ -n "$msg" ] || { echo "error: empty message" >&2; exit 1; }
    printf '[%s %s]%s :: %s\n' "$from" "$(now)" "$tos" "$msg" >>"$LOG"   # ' :: ' delimits address field from body
    echo "sent to$tos"
    ;;
  who)
    if [ ! -s "$ROSTER" ]; then echo "(nobody registered)"; exit 0; fi
    # Liveness is best-effort: there is no heartbeat, so we infer it from each
    # handle's LAST activity in the log. Older than the stale window => 'stale?'
    # (likely ended without 'bus leave', or just idle). Undated legacy lines can't
    # be judged and are shown without a flag.
    stale_hours=6
    stale_cut="$(now_minus_hours "$stale_hours")"
    while IFS='|' read -r hh pwd joined sid; do
      [ -n "$hh" ] || continue
      last="$(grep -iE "^\[$hh " "$LOG" 2>/dev/null | tail -1)"
      seen=""; flag=""
      if [ -n "$last" ]; then
        # extract 'MM-DD HH:MM' from '[handle MM-DD HH:MM] ...'
        seen="$(printf '%s' "$last" | sed -n 's/^\[[^ ]* \([0-9][0-9]-[0-9][0-9] [0-9][0-9]:[0-9][0-9]\)\].*/\1/p')"
      fi
      if [ -n "$seen" ]; then
        if [ -n "$stale_cut" ] && [ "$seen" \< "$stale_cut" ]; then flag=" — stale?"; fi
        printf "  @%-10s %s (joined %s, last seen %s%s)\n" "$hh" "$pwd" "$joined" "$seen" "$flag"
      elif [ -n "$last" ]; then
        # has log activity but only in the pre-dated-stamp format => hasn't spoken
        # since the upgrade. Can't time it, but that itself is a staleness signal.
        printf "  @%-10s %s (joined %s, last seen before dated-stamp upgrade — stale?)\n" "$hh" "$pwd" "$joined"
      else
        printf "  @%-10s %s (joined %s, no activity logged — stale?)\n" "$hh" "$pwd" "$joined"
      fi
    done < "$ROSTER"
    printf "  (liveness is best-effort — 'last seen' = last bus activity; a session may be idle-but-listening, or ended without 'bus leave')\n"
    ;;
  catchup)
    h="${1:?usage: bus catchup <handle> [hours]}"
    hours="${2:-12}"
    cut="$(now_minus_hours "$hours")"
    # Filter mentions of @h/@all (not self), then keep only lines newer than the
    # cutoff. Timestamp is fields 2 (MM-DD) + 3 (HH:MM]) of the '[' address token;
    # lexical compare of 'MM-DD HH:MM' is correct within a year. Undated legacy
    # lines (pre-dated-stamp) are dropped when a window applies — their recency
    # cannot be proven, and keeping them reproduces the old "re-dump" noise.
    # They remain visible via 'bus log'. Self-heals once sessions emit dated lines.
    awk -v h="$(printf '%s' "$h" | tr '[:upper:]' '[:lower:]')" -v cut="$cut" -F' :: ' '
      { a = tolower($1) }
      a ~ ("^\\[" h " ") { next }                              # drop self
      a !~ ("@(" h "|all)([^0-9a-z_]|$)") { next }             # must tag h/all
      {
        split($1, p, " ")                                      # p[2]=MM-DD p[3]=HH:MM]
        if (p[2] ~ /^[0-9][0-9]-[0-9][0-9]$/) {
          ts = p[2] " " substr(p[3], 1, 5)
          if (cut != "" && ts < cut) next                      # dated + older than window: drop
        } else if (cut != "") {
          next                                                 # undated (pre-dated-stamp): cannot prove recency, drop
        }
        print
      }
    ' "$LOG" 2>/dev/null | tail -40
    ;;
  log)
    tail -n "${1:-80}" "$LOG"
    ;;
  leave)
    case "${1:-}" in
      # Used by the SessionEnd hook: deregister whoever this session registered as.
      # Silent no-op (rc 0) when the session never joined — the hook fires for every
      # Claude Code session on the machine, bus user or not.
      --by-session)
        sid="${2:?usage: bus leave --by-session <session-id>}"
        lock
        hs="$(handles_by_session "$sid")"
        [ -n "$hs" ] || { echo "no bus registration for session $sid"; exit 0; }
        for h in $hs; do do_leave "$h"; echo "left: @$h"; done
        ;;
      # Fallback for when no session id is available. Ambiguous by design when
      # several handles share a cwd, so it refuses rather than guessing.
      --by-cwd)
        force=""; [ "${2:-}" = "--force" ] && { force=1; shift; }
        p="${2:?usage: bus leave --by-cwd [--force] <path>}"
        lock
        hs="$(handles_by_cwd "$p")"
        n="$(printf '%s' "$hs" | grep -c '[^[:space:]]')"
        [ "$n" -gt 0 ] || { echo "no bus registration for $p"; exit 0; }
        if [ "$n" -gt 1 ] && [ -z "$force" ]; then
          echo "error: $n handles registered at $p ($(echo $hs | tr '\n' ' ')) — pass a handle explicitly, or --force to drop all" >&2
          exit 1
        fi
        for h in $hs; do do_leave "$h"; echo "left: @$h"; done
        ;;
      *)
        h="${1:?usage: bus leave <handle> | --by-session <id> | --by-cwd [--force] <path>}"
        lock
        do_leave "$h"
        echo "left."
        ;;
    esac
    ;;
  *)
    cat >&2 <<'EOF'
bus — local coordination for Claude Code sessions
  bus join <handle>              register + print your Monitor listen command
  bus send <from> @to [..] msg   post a message tagging recipient(s); @all = broadcast
  bus who                        list registered handles
  bus catchup <handle> [hours]   messages that tagged you in the last N hours (default 12)
  bus log [N]                    tail the shared log for full context (default 80)
  bus leave <handle>             deregister
  bus leave --by-session <id>    deregister whatever that Claude session joined as (used by the SessionEnd hook)
  bus leave --by-cwd [--force] <path>
                                 deregister by working directory (refuses if >1 handle shares it)
EOF
    exit 1
    ;;
esac
